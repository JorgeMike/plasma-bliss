# Bliss — configuracion de la decoracion Aurorae
#
# Las claves marcadas (*) NO aparecen como cadenas en el binario de Plasma 6.3
# (org.kde.kwin.aurorae.so), asi que el plugin no las lee. Se dejan porque son
# inofensivas y porque muchos temas de la KDE Store las traen, pero no esperes
# que hagan nada. Lista de claves verificadas en docs/formats.md.

[General]
ActiveTextColor=255,255,255
ActiveTextShadowColor=0,40,110,160
Animation=120
InactiveTextColor=222,233,250
InactiveTextShadowColor=60,90,150,120
TextShadowOffsetX=1
TextShadowOffsetY=1
TitleAlignment=Left
TitleVerticalAlignment=Center
UseTextShadow=true

# (*) En Plasma 6 el orden de los botones sale de Preferencias del sistema >
#     Decoracion de ventanas, no del tema. Para el aspecto XP quieres el icono
#     de la aplicacion a la izquierda y minimizar/maximizar/cerrar a la derecha.
LeftButtons=M
RightButtons=IAX
Shadow=true

[Layout]
# Borde superior real = TitleHeight + TitleEdgeTop + TitleEdgeBottom
#                     = 22 + 4 + 4 = 30 px, la altura de Luna a 96 dpi.
TitleHeight=22
TitleEdgeTop=4
TitleEdgeBottom=4
TitleEdgeLeft=5
TitleEdgeRight=4
TitleBorderLeft=4
TitleBorderRight=4

# Maximizada: XP pega la barra al borde de la pantalla.
TitleEdgeTopMaximized=2
TitleEdgeBottomMaximized=2
TitleEdgeLeftMaximized=2
TitleEdgeRightMaximized=2
ButtonMarginTopMaximized=2

BorderBottom=5
BorderTop=30

# (*) El ancho de los bordes laterales lo decide el usuario en Preferencias del
#     sistema > Decoracion de ventanas > Tamano del borde. El tema no manda.
BorderLeft=5
BorderRight=5

ButtonHeight=21
ButtonWidth=21
ButtonWidthClose=25
ButtonMarginTop=4
ButtonSpacing=1
ExplicitButtonSpacer=4

# Espacio para la sombra dibujada por el tema. En Wayland la sombra la pone
# KWin, asi que 0.
PaddingTop=0
PaddingBottom=0
PaddingLeft=0
PaddingRight=0
