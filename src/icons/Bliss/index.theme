[Icon Theme]
Name=Bliss
Comment=Windows XP Luna x Frutiger Aero

# Hereda de Papirus-Dark: cualquier icono que no este aqui sale de ahi.
# Esto es lo que hace viable el proyecto — no dibujas 1500 iconos, cubres los
# que se ven a diario y dejas que el resto caiga por herencia.
#
# Papirus y no breeze porque es el que usa este escritorio y porque su
# cobertura es mayor. breeze y hicolor quedan detras como red.
Inherits=Papirus-Dark,Papirus,breeze,hicolor
Example=folder

# Los mapas de bits de places, devices y mimetypes NO estan en el
# repositorio: los trae `make icons` desde LinXP a build/, porque LinXP no
# publica licencia. Declarar aqui sus directorios no molesta si faltan: la
# busqueda simplemente no encuentra nada y sigue hacia Papirus.
Directories=16x16/places,16x16/devices,16x16/mimetypes,24x24/places,24x24/devices,24x24/mimetypes,32x32/places,32x32/devices,32x32/mimetypes,48x48/places,48x48/devices,48x48/mimetypes,128x128/places,22x22/places,scalable/places,22x22/apps,48x48/apps,scalable/apps

[16x16/places]
Size=16
Context=Places
Type=Fixed

[16x16/devices]
Size=16
Context=Devices
Type=Fixed

[16x16/mimetypes]
Size=16
Context=MimeTypes
Type=Fixed

[24x24/places]
Size=24
Context=Places
Type=Fixed

[24x24/devices]
Size=24
Context=Devices
Type=Fixed

[24x24/mimetypes]
Size=24
Context=MimeTypes
Type=Fixed

[32x32/places]
Size=32
Context=Places
Type=Fixed

[32x32/devices]
Size=32
Context=Devices
Type=Fixed

[32x32/mimetypes]
Size=32
Context=MimeTypes
Type=Fixed

[48x48/places]
Size=48
Context=Places
Type=Fixed

[48x48/devices]
Size=48
Context=Devices
Type=Fixed

[48x48/mimetypes]
Size=48
Context=MimeTypes
Type=Fixed

[128x128/places]
Size=128
Context=Places
Type=Fixed

[22x22/places]
Size=22
Context=Places
Type=Fixed

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[22x22/apps]
Size=22
Context=Applications
Type=Fixed

[48x48/apps]
Size=48
Context=Applications
Type=Fixed

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable
