[Icon Theme]
Name=Bliss
Comment=Windows XP Luna x Frutiger Aero
# Hereda de breeze: cualquier icono que no definas aqui sale de Breeze.
# Esto es lo que hace viable el proyecto — no dibujas 1500 iconos, dibujas
# los 40 que se ven a diario y dejas que el resto caiga por herencia.
Inherits=breeze,hicolor
Example=folder

Directories=16x16/places,22x22/places,32x32/places,48x48/places,scalable/places

[16x16/places]
Size=16
Context=Places
Type=Fixed

[22x22/places]
Size=22
Context=Places
Type=Fixed

[32x32/places]
Size=32
Context=Places
Type=Fixed

[48x48/places]
Size=48
Context=Places
Type=Fixed

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
